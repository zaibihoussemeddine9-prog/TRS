# --- Base de données ---
# Local: postgresql://postgres:postgres@localhost:5432/pharma_trs?schema=public
# Railway: fournie automatiquement via la variable DATABASE_URL du service PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharma_trs?schema=public"

# --- NextAuth ---
# Générer un secret: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-secret-key"
# Railway: https://your-app.up.railway.app
NEXTAUTH_URL="http://localhost:3000"

# --- Railway (ajoutées automatiquement) ---
# PORT=3000              # Railway définit cette variable automatiquement
# RAILWAY_ENVIRONMENT=   # "production" en prod

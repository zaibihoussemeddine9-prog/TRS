generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS
// ============================================

enum UserRole {
  ADMIN
  RESPONSABLE
  OPERATEUR
  LECTURE_SEULE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(OPERATEUR)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches    Batch[]    @relation("BatchCreatedBy")
  downtimes  Downtime[] @relation("DowntimeCreatedBy")
  auditLogs  AuditLog[]

  @@index([email])
}

// ============================================
// LINE
// ============================================

model Line {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  lineType  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches   Batch[]

  @@index([code])
}

// ============================================
// PRODUCT
// ============================================

model Product {
  id                 String  @id @default(cuid())
  name               String
  code               String  @unique
  family             String?
  form               String?
  dosage             String?
  unitsPerPack       Int?
  nominalSpeed       Float?
  targetOEE          Float?
  targetRejectRate   Float?
  standardLotSize    Float?
  formatChangeTime   Float?
  cleaningTime       Float?
  comments           String? @db.Text
  active             Boolean @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  batches   Batch[]

  @@index([code])
}

// ============================================
// DOWNTIME TYPE (referential)
// ============================================

model DowntimeType {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  category  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  downtimes Downtime[]
}

// ============================================
// BATCH (lot de production)
// ============================================

model Batch {
  id                String   @id @default(cuid())
  lot               String
  lineId            String
  productId         String
  date              DateTime @db.Date
  shift             String
  orderNumber       String?

  // Times (minutes)
  plannedTime       Float    @default(0)
  actualRunningTime Float    @default(0)

  // Speed
  theoreticalSpeed  Float    @default(0)
  actualSpeed       Float    @default(0)

  // Quantities
  quantityProduced  Float    @default(0)
  quantityConform   Float    @default(0)
  quantityRejected  Float    @default(0)

  // Calculated KPIs
  availability      Float?
  performance       Float?
  quality           Float?
  oee               Float?

  comment           String?
  status            String   @default("DRAFT")

  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  line      Line      @relation(fields: [lineId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  createdBy User      @relation("BatchCreatedBy", fields: [createdById], references: [id])
  downtimes Downtime[]

  @@index([lineId])
  @@index([productId])
  @@index([date])
  @@index([lot])
}

// ============================================
// DOWNTIME (arrêt)
// ============================================

model Downtime {
  id              String   @id @default(cuid())
  batchId         String
  downtimeTypeId  String
  startTime       DateTime
  endTime         DateTime?
  duration        Float?
  description     String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  batch        Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  downtimeType DowntimeType @relation(fields: [downtimeTypeId], references: [id])
  createdBy    User         @relation("DowntimeCreatedBy", fields: [createdById], references: [id])

  @@index([batchId])
  @@index([downtimeTypeId])
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

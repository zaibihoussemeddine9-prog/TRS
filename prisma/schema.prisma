generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  password  String
  role      String   @default("RIDER")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rentals Rental[]

  @@index([email])
}

model Scooter {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  status       String   @default("AVAILABLE") // AVAILABLE | RENTED | MAINTENANCE | OFFLINE
  battery      Int      @default(100)
  lat          Float    @default(36.7538)
  lng          Float    @default(3.0588)
  address      String?
  pricePerMin  Float    @default(2.5)
  maxSpeed     Int      @default(25)
  model        String   @default("Xiaomi Pro 2")
  color        String   @default("#10b981")
  lastPing     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rentals    Rental[]
  gpsHistory GpsPoint[]

  @@index([status])
  @@index([code])
}

model Rental {
  id            String    @id @default(cuid())
  userId        String
  scooterId     String
  startTime     DateTime  @default(now())
  endTime       DateTime?
  startLat      Float?
  startLng      Float?
  endLat        Float?
  endLng        Float?
  durationMin   Float?
  totalCost     Float?
  status        String    @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  paymentStatus String    @default("PENDING") // PENDING | PAID
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  scooter Scooter @relation(fields: [scooterId], references: [id])

  @@index([userId])
  @@index([scooterId])
  @@index([status])
}

model GpsPoint {
  id        String   @id @default(cuid())
  scooterId String
  lat       Float
  lng       Float
  speed     Float?
  battery   Int?
  createdAt DateTime @default(now())

  scooter Scooter @relation(fields: [scooterId], references: [id], onDelete: Cascade)

  @@index([scooterId])
  @@index([createdAt])
}

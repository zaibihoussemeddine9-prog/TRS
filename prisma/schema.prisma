generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS
// ============================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("OPERATEUR")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches          Batch[]           @relation("BatchCreatedBy")
  downtimeEvents   DowntimeEvent[]   @relation("DowntimeCreatedBy")
  shiftProductions ShiftProduction[] @relation("ShiftProdCreatedBy")
  auditLogs        AuditLog[]

  @@index([email])
}

// ============================================
// LINE
// ============================================

model Line {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  lineType  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches Batch[]

  @@index([code])
}

// ============================================
// PRODUCT
// ============================================

model Product {
  id               String   @id @default(cuid())
  name             String
  code             String   @unique
  family           String?
  form             String?
  dosage           String?
  unitsPerPack     Int?
  nominalSpeed     Float?
  targetOEE        Float?
  targetRejectRate Float?
  standardLotSize  Float?
  formatChangeTime Float?
  cleaningTime     Float?
  comments         String?  @db.Text
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  batches Batch[]

  @@index([code])
}

// ============================================
// DOWNTIME HIERARCHY: Category > SubCategory > Type
// ============================================

model DowntimeCategory {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  color       String   @default("#3b82f6")
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subCategories DowntimeSubCategory[]

  @@index([code])
}

model DowntimeSubCategory {
  id         String   @id @default(cuid())
  name       String
  code       String   @unique
  categoryId String
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category      DowntimeCategory @relation(fields: [categoryId], references: [id])
  downtimeTypes DowntimeType[]

  @@index([categoryId])
  @@index([code])
}

model DowntimeType {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  subCategoryId String
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subCategory    DowntimeSubCategory @relation(fields: [subCategoryId], references: [id])
  downtimeEvents DowntimeEvent[]

  @@index([subCategoryId])
  @@index([code])
}

// ============================================
// BATCH (lot de production)
// ============================================

model Batch {
  id          String   @id @default(cuid())
  lot         String
  lineId      String
  productId   String
  date        DateTime @db.Date
  orderNumber String?
  status      String   @default("OPEN")
  comment     String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  line             Line              @relation(fields: [lineId], references: [id])
  product          Product           @relation(fields: [productId], references: [id])
  createdBy        User              @relation("BatchCreatedBy", fields: [createdById], references: [id])
  downtimeEvents   DowntimeEvent[]
  shiftProductions ShiftProduction[]

  @@index([lineId])
  @@index([productId])
  @@index([date])
  @@index([lot])
}

// ============================================
// DOWNTIME EVENT (arret enregistre sur un lot)
// ============================================

model DowntimeEvent {
  id             String    @id @default(cuid())
  batchId        String
  downtimeTypeId String
  startTime      DateTime
  endTime        DateTime?
  duration       Float?
  description    String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  batch        Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  downtimeType DowntimeType @relation(fields: [downtimeTypeId], references: [id])
  createdBy    User         @relation("DowntimeCreatedBy", fields: [createdById], references: [id])

  @@index([batchId])
  @@index([downtimeTypeId])
}

// ============================================
// SHIFT PRODUCTION (quantite produite par shift)
// ============================================

model ShiftProduction {
  id               String   @id @default(cuid())
  batchId          String
  shift            String
  date             DateTime @db.Date
  quantityProduced Float    @default(0)
  quantityConform  Float    @default(0)
  quantityRejected Float    @default(0)
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  batch     Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdBy User  @relation("ShiftProdCreatedBy", fields: [createdById], references: [id])

  @@index([batchId])
  @@index([date])
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}
